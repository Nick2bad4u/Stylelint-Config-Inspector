{
    "name": "stylelint-config-inspector",
    "version": "2.3.4",
    "private": false,
    "description": "A visual tool for inspecting and understanding your Stylelint configs",
    "keywords": [
        "@stylelint",
        "@stylelint/config-inspector",
        "config",
        "eslint-inspector",
        "inspector",
        "stylelint",
        "stylelint-config",
        "stylelint-config-inspector",
        "stylelint-inspector",
        "stylelint-plugin",
        "tool",
        "visualization"
    ],
    "homepage": "https://github.com/Nick2bad4u/Stylelint-Config-Inspector#readme",
    "bugs": "https://github.com/Nick2bad4u/Stylelint-Config-Inspector/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Nick2bad4u/Stylelint-Config-Inspector.git"
    },
    "funding": "https://opencollective.com/stylelint",
    "license": "Apache-2.0",
    "author": "Nick2bad4u <20943337+Nick2bad4u@users.noreply.github.com> (https://nick2bad4u.github.io/eslint-plugin-typefest)",
    "contributors": [
        {
            "name": "Nick2bad4u",
            "email": "20943337+Nick2bad4u@users.noreply.github.com",
            "url": "https://nick2bad4u.github.io/eslint-plugin-typefest"
        }
    ],
    "type": "module",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/cli.d.mts",
                "default": "./dist/cli.mjs"
            },
            "require": {
                "types": "./dist/cli.d.cts",
                "default": "./dist/cli.cjs"
            },
            "default": "./dist/cli.mjs"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/cli.cjs",
    "types": "./dist/cli.d.mts",
    "bin": {
        "stylelint-config-inspector": "bin.mjs"
    },
    "files": [
        "*.mjs",
        "dist"
    ],
    "scripts": {
        "build": "nuxt build && tsdown",
        "changelog:release-notes": "git-cliff --config cliff.toml --current --strip all",
        "check": "npm run lint && npm run lint:stylelint && npm run typecheck && npm run test && npm run build",
        "contrib": "all-contributors",
        "contrib:add": "all-contributors add",
        "contrib:check": "all-contributors check",
        "contrib:compare": "npm run contrib:check",
        "contrib:generate": "all-contributors generate",
        "dev": "nuxt dev",
        "lint": "npm run lint:node-version-files && npm run lint:prettier && eslint --cache --cache-strategy content --cache-location .cache/.eslintcache",
        "lint:all": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache && npm run lint:stylelint && npm run typecheck",
        "lint:all:fix": "eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix && npm run lint:stylelint:fix && npm run typecheck && npm run lint:prettier:fix",
        "lint:fix": "npm run sync:node-version-files && npm run lint:prettier:fix && eslint --cache --cache-strategy content --cache-location .cache/.eslintcache --fix",
        "lint:node-version-files": "node scripts/sync-node-version-files.mjs --check",
        "lint:package": "npm run lint:node-version-files && npm run lint:package-sort-check && npm run lint:packagelintrc && npm run lint:tsdown",
        "lint:package:strict": "npm run lint:node-version-files && npm run lint:package-sort-check && npm run lint:package-check && npm run lint:packagelintrc && npm run lint:tsdown",
        "lint:package-check": "publint && attw --pack .",
        "lint:package-check:strict": "publint && attw --pack . --profile strict",
        "lint:package-sort": "sort-package-json \"./package.json\" \"./docs/docusaurus/package.json\"",
        "lint:package-sort-check": "sort-package-json --check \"./package.json\" \"./docs/docusaurus/package.json\"",
        "lint:packagelintrc": "npmPkgJsonLint . --config .npmpackagejsonlintrc.json",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:release": "npm run lint:all:fix && npm run lint:package-sort && npm run lint:package:strict",
        "lint:stylelint": "stylelint \"**/*.{css,scss,sass,less,pcss,vue,html}\" --allow-empty-input --cache --cache-location .cache/.stylelintcache --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\" --ignore-pattern \".nuxt/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"docs/docusaurus/build/**\"",
        "lint:stylelint:fix": "stylelint \"**/*.{css,scss,sass,less,pcss,vue,html}\" --allow-empty-input --cache --cache-location .cache/.stylelintcache --ignore-pattern \"playwright-report/**\" --ignore-pattern \"test-results/**\" --ignore-pattern \".nuxt/**\" --ignore-pattern \"dist/**\" --ignore-pattern \"docs/docusaurus/build/**\" --fix",
        "lint:tsdown": "tsdown --no-write",
        "lint:tsdown:build": "tsdown",
        "prepack": "npm run build",
        "prebench": "npm run build",
        "prepare": "nuxt prepare",
        "release:check": "npm run check && npm run lint:package:strict && npm pack --dry-run",
        "prestart": "npm run build",
        "start": "node bin.mjs",
        "sync:node-version-files": "node scripts/sync-node-version-files.mjs",
        "test": "vitest --run",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test",
        "test:e2e:headed": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test --headed",
        "test:e2e:ui": "cross-env NODE_OPTIONS=--disable-warning=DEP0205 playwright test --ui",
        "typecheck": "nuxt typecheck",
        "update-actions": "npx actions-up --yes --style sha",
        "update-deps": "npx ncu -i --install never && npm install --force"
    },
    "dependencies": {
        "ansis": "^4.3.1",
        "bundle-require": "^5.1.0",
        "cac": "^7.0.0",
        "chokidar": "^5.0.0",
        "esbuild": "^0.28.0",
        "h3": "^2.0.1-rc.22",
        "tinyglobby": "^0.2.17",
        "ts-extras": "^1.0.0",
        "type-fest": "^5.7.0",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.0.0",
        "@arethetypeswrong/cli": "^0.18.3",
        "@csstools/stylelint-formatter-github": "^2.0.0",
        "@double-great/remark-lint-alt-text": "^1.1.1",
        "@eslint/compat": "^2.1.0",
        "@eslint/config-array": "^0.23.5",
        "@eslint/config-helpers": "^0.6.0",
        "@eslint/config-inspector": "^3.0.4",
        "@eslint/css": "^1.3.0",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.0",
        "@eslint/markdown": "^8.0.2",
        "@html-eslint/parser": "^0.61.0",
        "@iconify-json/carbon": "^1.2.22",
        "@iconify-json/file-icons": "^1.2.2",
        "@iconify-json/logos": "^1.2.11",
        "@iconify-json/ph": "^1.2.2",
        "@iconify-json/simple-icons": "^1.2.84",
        "@iconify-json/svg-spinners": "^1.2.4",
        "@iconify-json/twemoji": "^1.2.5",
        "@iconify-json/vscode-icons": "^1.2.53",
        "@microsoft/tsdoc-config": "^0.18.1",
        "@nodelib/fs.walk": "^3.0.1",
        "@nuxt/eslint": "^1.15.2",
        "@nuxt/eslint-config": "^1.15.2",
        "@playwright/test": "^1.60.0",
        "@shikijs/langs-precompiled": "^4.1.0",
        "@shikijs/transformers": "^4.1.0",
        "@stryker-ignorer/console-all": "^0.3.2",
        "@stryker-mutator/core": "^9.6.1",
        "@stryker-mutator/typescript-checker": "^9.6.1",
        "@stryker-mutator/vitest-runner": "^9.6.1",
        "@types/connect": "^3.4.38",
        "@types/htmlhint": "^1.1.5",
        "@types/madge": "^5.0.3",
        "@types/node": "^25.9.1",
        "@types/postcss-clamp": "^4.1.3",
        "@types/postcss-flexbugs-fixes": "^5.0.3",
        "@types/postcss-html": "^1.5.3",
        "@types/postcss-import": "^14.0.3",
        "@types/ws": "^8.18.1",
        "@unocss/eslint-config": "^66.7.0",
        "@unocss/nuxt": "^66.7.0",
        "@vitest/coverage-v8": "^4.1.8",
        "@voxpelli/config-array-find-files": "^1.2.2",
        "@vueuse/nuxt": "^14.3.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.4.1",
        "fast-check": "^4.8.0",
        "find-up": "^8.0.0",
        "floating-vue": "^5.2.2",
        "fuse.js": "^7.4.0",
        "get-port-please": "^3.2.0",
        "git-cliff": "^2.13.1",
        "gitleaks-secret-scanner": "^2.1.1",
        "globals": "^17.6.0",
        "htmlhint": "^1.9.2",
        "jscpd": "^4.2.4",
        "jsonc-eslint-parser": "^3.1.0",
        "knip": "^6.15.0",
        "leasot": "^14.4.0",
        "madge": "^8.0.0",
        "markdown-link-check": "^3.14.2",
        "minimatch": "^10.2.5",
        "mlly": "^1.8.2",
        "mrmime": "^2.0.1",
        "npm-check-updates": "^22.2.1",
        "npm-package-json-lint": "^10.4.0",
        "nuxt": "^4.4.6",
        "nuxt-eslint-auto-explicit-import": "^0.2.0",
        "open": "^11.0.0",
        "pathe": "^2.0.3",
        "picocolors": "^1.1.1",
        "postcss": "^8.5.15",
        "postcss-assets": "^6.0.0",
        "postcss-clamp": "^4.1.0",
        "postcss-combine-duplicated-selectors": "^10.0.3",
        "postcss-flexbugs-fixes": "^5.0.2",
        "postcss-import": "^16.1.1",
        "postcss-inline-svg": "^6.0.0",
        "postcss-logical": "^9.0.0",
        "postcss-normalize": "^13.0.1",
        "postcss-reporter": "^7.1.0",
        "postcss-round-subpixels": "^2.0.0",
        "postcss-sort-media-queries": "^6.6.1",
        "postcss-viewport-height-correction": "^1.1.1",
        "prettier": "^3.8.3",
        "prettier-config-nick2bad4u": "^1.0.13",
        "publint": "^0.3.21",
        "recheck-jar": "^4.5.0",
        "rehype-katex": "^7.0.1",
        "remark": "^15.0.1",
        "remark-cli": "^12.0.1",
        "remark-config-nick2bad4u": "^1.0.3",
        "rimraf": "^6.1.3",
        "rolldown": "^1.0.3",
        "rollup": "^4.61.0",
        "secretlint": "^13.0.2",
        "secretlint-config-nick2bad4u": "^1.1.0",
        "shiki": "^4.1.0",
        "sloc": "^0.3.2",
        "sort-package-json": "^3.6.1",
        "stylelint": "^17.12.0",
        "stylelint-config-nick2bad4u": "^1.0.15",
        "textmate-grammar-glob": "^0.0.1",
        "toml-eslint-parser": "^1.0.3",
        "ts-unused-exports": "^11.0.1",
        "tsdown": "^0.22.1",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0",
        "typesync": "^0.14.3",
        "unrun": "^0.3.0",
        "vfile": "^6.0.3",
        "vite": "^8.0.16",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.8",
        "vue-tsc": "^3.3.3",
        "yaml-eslint-parser": "^2.0.0",
        "yamllint-js": "^0.2.4"
    },
    "peerDependencies": {
        "stylelint": "^16.0.0 || ^17.0.0"
    },
    "packageManager": "npm@11.16.0",
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
    }
}
